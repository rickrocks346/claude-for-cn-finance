{
  "name": "claude-for-cn-finance",
  "owner": {
    "name": "rickrocks346"
  },
  "metadata": {
    "description": "面向中国金融从业者的 Claude plugin 工具集 — A股研究、基金分析、固收理财、风险画像",
    "version": "0.1.0"
  },
  "plugins": [
    {
      "name": "financial-analysis",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/vertical-plugins/financial-analysis"
      },
      "description": "核心层：金融建模 + AKShare/Tushare 数据连接器 — DCF、可比分析、Excel审计、数据清洗、宏观指标",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "a-share-research",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/vertical-plugins/a-share-research"
      },
      "description": "A股研究：财报解读、可比公司筛选、板块轮动、政策影响分析、公司一页纸速览",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "fund-analysis",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/vertical-plugins/fund-analysis"
      },
      "description": "基金分析：多维度筛选、持仓穿透、Brinson业绩归因、风格漂移检测、经理能力评估",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "fixed-income",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/vertical-plugins/fixed-income"
      },
      "description": "固收理财：债券YTM/久期/凸性、收益率曲线、可转债条款博弈、银行理财产品分析",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "risk-profiling",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/vertical-plugins/risk-profiling"
      },
      "description": "风险画像：组合风险指标、C1-C5匹配度诊断、多维度集中度、历史极端事件压力测试",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "market-researcher",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/agent-plugins/market-researcher"
      },
      "description": "A股市场研究 agent — 财报分析、行业比较、估值建模、政策影响、板块轮动，end to end",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "fund-screener",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/agent-plugins/fund-screener"
      },
      "description": "基金筛选分析 agent — 多维筛选、持仓穿透、业绩归因、风格漂移检测、经理评估",
      "version": "0.1.0",
      "strict": true
    },
    {
      "name": "risk-advisor",
      "source": {
        "source": "url",
        "url": "https://github.com/rickrocks346/claude-for-cn-finance.git",
        "path": "plugins/agent-plugins/risk-advisor"
      },
      "description": "组合风险诊断 agent — 风险指标计算、压力测试、集中度分析、C1-C5匹配度诊断",
      "version": "0.1.0",
      "strict": true
